---
import Icon from './Icon.astro';

interface Props {
  email: string;
}
const { email } = Astro.props;
---

<button type="button" class="copy" data-copy={email} aria-label="Copy email address">
  <Icon name="copy" class="i-copy" />
  <Icon name="check" class="i-check" />
  <span class="toast" role="status" aria-live="polite"></span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const toast = button.querySelector('.toast');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return; // Clipboard blocked: the mailto button still works.
      }
      button.classList.add('copied');
      if (toast) toast.textContent = 'Copied';
      setTimeout(() => {
        button.classList.remove('copied');
        if (toast) toast.textContent = '';
      }, 1800);
    });
  });
</script>

<style>
  .copy {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-2);
    cursor: pointer;
    transition: border-color var(--t-hover) var(--ease-out);
  }
  .copy:hover {
    border-color: var(--text-muted);
  }
  .copy :global(.icon) {
    grid-area: 1 / 1;
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .copy :global(.i-check),
  .copied :global(.i-copy) {
    opacity: 0;
    transform: scale(0.6);
  }
  .copied :global(.i-check) {
    opacity: 1;
    transform: none;
    color: var(--success);
  }
  .toast {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    translate: -50% 0;
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--text);
    color: var(--bg);
    font-size: 0.8125rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 160ms var(--ease-out);
  }
  .copied .toast {
    opacity: 1;
  }
</style>
