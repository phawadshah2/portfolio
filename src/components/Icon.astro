export type IconName = keyof typeof paths;

interface Props {
  name: IconName | string;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 18, label, class: className } = Astro.props;
const markup = (paths as Record<string, string>)[name] ?? paths.check;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={markup}
/>

<style>
  .icon {
    flex: none;
  }
</style>
