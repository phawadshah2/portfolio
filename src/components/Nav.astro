---
import { url } from '../lib/paths';
import Icon from './Icon.astro';

interface Props {
  name: string;
  role: string;
  cv: string;
}
const { name, role, cv } = Astro.props;

// `section` ids drive the scroll-spy underline on the home page.
const links = [
  { href: url('/#work'), label: 'Work', section: 'work' },
  { href: url('/#services'), label: 'Services', section: 'services' },
  { href: url('/#about'), label: 'About', section: 'about' },
  { href: url('/#contact'), label: 'Contact', section: 'contact' },
];
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <a href={url('/')} class="brand" aria-label={`${name}, home`}>
      <span class="brand-name">{name}</span>
      <span class="brand-dot" aria-hidden="true"></span>
      <span class="brand-role">{role}</span>
    </a>

    <nav aria-label="Main" class="center">
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="link" data-spy={l.section}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a href={url(cv)} class="cv" download>
        <Icon name="download" size={18} />
        Download CV
      </a>
      <a href={url('/#contact')} class="hire">
        Hire me
        <Icon name="arrow-right" size={18} />
      </a>

      <!-- <details> works without JavaScript; the script only closes it. -->
      <details class="menu" data-menu>
        <summary aria-label="Menu">
          <Icon name="menu" class="i-open" size={22} />
          <Icon name="close" class="i-close" size={22} />
        </summary>
        <ul class="menu-panel">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li>
            <a href={url(cv)} download>Download CV</a>
          </li>
        </ul>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile menu after choosing a section or tapping outside.
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => menu.removeAttribute('open')),
  );
  document.addEventListener('click', (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.removeAttribute('open');
  });

  // Scroll spy: underline the link of the section being read. Sections are
  // matched by id; on pages without them nothing is highlighted.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const sections = links
    .map((l) => document.getElementById(l.dataset.spy ?? ''))
    .filter((s): s is HTMLElement => s !== null);
  if (sections.length) {
    const setActive = (id: string | null) =>
      links.forEach((l) => {
        const on = l.dataset.spy === id;
        l.classList.toggle('active', on);
        if (on) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
      });
    const visible = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) visible.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0);
        // The section closest to the top of the reading zone wins.
        const current = sections.find((s) => (visible.get(s.id) ?? 0) > 0);
        setActive(current?.id ?? null);
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.01] },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    box-shadow: var(--shadow-sm);
  }
  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    height: 64px;
  }
  @media (min-width: 1024px) {
    .nav-inner {
      height: 80px;
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
  }
  .brand-name {
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .brand-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary-bright);
  }
  .brand-role {
    display: none;
    padding: 2px 10px;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, #bccac0 40%, transparent);
    background: var(--surface-container);
    color: var(--text-2);
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
  }
  @media (min-width: 640px) {
    .brand-dot {
      display: none;
    }
    .brand-role {
      display: inline-block;
    }
  }

  .center {
    display: none;
  }
  .links {
    display: flex;
    gap: 32px;
  }
  .link {
    position: relative;
    display: block;
    padding: 4px 0;
    color: var(--text-2);
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    transition: color var(--t-hover) var(--ease-out);
  }
  /* Underline grows from the left; scaleX is compositor-only. */
  .link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    border-radius: 2px;
    background: var(--primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-return) var(--ease-out);
  }
  .link:hover {
    color: var(--text);
  }
  .link:hover::after {
    transform: scaleX(0.5);
  }
  .link.active {
    color: var(--primary);
    font-weight: 600;
  }
  .link.active::after {
    transform: scaleX(1);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cv,
  .hire {
    display: none;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border-radius: var(--r);
    font-size: 14px;
    font-weight: 500;
    transition:
      background-color var(--t-hover) var(--ease-out),
      border-color var(--t-hover) var(--ease-out),
      transform var(--t-press) var(--ease-out);
  }
  .cv {
    border: 1px solid var(--border-strong);
    background: var(--surface);
  }
  .cv:hover {
    background: var(--surface-low);
  }
  .hire {
    display: inline-flex;
    padding: 0 18px;
    background: var(--primary);
    color: #fff;
    font-weight: 600;
  }
  .hire :global(.icon) {
    display: none;
    transition: transform var(--t-hover) var(--ease-out);
  }
  .hire:hover {
    background: var(--primary-hover);
  }
  .hire:hover :global(.icon) {
    transform: translateX(3px);
  }
  .cv:active,
  .hire:active {
    transform: scale(0.97);
  }

  .menu {
    position: relative;
  }
  .menu summary {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r);
    list-style: none;
    cursor: pointer;
    color: var(--text);
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary > :global(.icon) {
    grid-area: 1 / 1;
    transition:
      transform 260ms var(--ease-out),
      opacity 180ms var(--ease-out);
  }
  .menu :global(.i-close),
  .menu[open] :global(.i-open) {
    opacity: 0;
    transform: rotate(-90deg);
  }
  .menu[open] :global(.i-close) {
    opacity: 1;
    transform: none;
  }
  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 210px;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lg);
    transform-origin: top right;
    animation: menu-in 180ms var(--ease-out);
  }
  .menu-panel a {
    display: block;
    padding: 12px 14px;
    border-radius: var(--r);
    font-weight: 500;
  }
  .menu-panel a:hover {
    background: var(--surface-low);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(-4px);
    }
  }

  @media (min-width: 768px) {
    .center {
      display: block;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
    .menu {
      display: none;
    }
    .hire :global(.icon) {
      display: block;
    }
  }
  @media (min-width: 1024px) {
    .cv {
      display: inline-flex;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .links {
      gap: 20px;
    }
    .brand-role {
      display: none;
    }
  }
</style>
