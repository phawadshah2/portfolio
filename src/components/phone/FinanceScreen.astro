---
/**
 * Hero phone screen from the design (fintech dashboard). Elements tagged
 * `.ui` animate in once the phone has settled; see .settled rules below.
 */
import Icon from '../Icon.astro';

const bars = [
  { h: 33, tone: 'muted' },
  { h: 50, tone: 'muted' },
  { h: 67, tone: 'p40' },
  { h: 58, tone: 'p60' },
  { h: 92, tone: 'p' },
  { h: 75, tone: 'p2' },
  { h: 100, tone: 'p' },
];
---

<div class="app">
  <div class="top">
    <div>
      <p class="hello">Welcome back,</p>
      <p class="user">Alex M.</p>
    </div>
    <div class="avatar">FS</div>
  </div>

  <div class="body">
    <div class="balance ui" style="--u: 0">
      <div class="row">
        <span class="overline">Total Portfolio</span>
        <Icon name="trending-up" size={16} />
      </div>
      <div class="amount" data-count="$48,290.40" data-count-start="41000">$48,290.40</div>
      <div class="delta"><span>+14.2%</span> vs last month</div>
    </div>

    <div class="pulse ui" style="--u: 1">
      <div class="row">
        <span class="title">Performance Pulse</span>
        <span class="fps">60 FPS</span>
      </div>
      <div class="bars">
        {bars.map((b, i) => <span class={b.tone} style={`--h: ${b.h}%; --b: ${i}`} />)}
      </div>
    </div>

    <div class="transfers">
      <div class="row ui" style="--u: 2">
        <span class="title">Recent Transfers</span>
        <span class="link">View all</span>
      </div>
      <div class="tx ui" style="--u: 3">
        <div class="tx-left">
          <span class="tx-icon"><Icon name="bag" size={14} /></span>
          <div>
            <p class="tx-name">Apple Store</p>
            <p class="tx-sub">Electronics</p>
          </div>
        </div>
        <span class="tx-amt">-$1,199</span>
      </div>
      <div class="tx ui" style="--u: 4">
        <div class="tx-left">
          <span class="tx-icon"><Icon name="bank" size={14} /></span>
          <div>
            <p class="tx-name">Client Payment</p>
            <p class="tx-sub">Stripe Inward</p>
          </div>
        </div>
        <span class="tx-amt plus">+$4,500</span>
      </div>
    </div>
  </div>

  <nav class="dock" aria-hidden="true">
    <Icon name="home" size={20} class="on" />
    <Icon name="analytics" size={20} />
    <Icon name="wallet" size={20} />
    <Icon name="person" size={20} />
  </nav>
</div>

<style>
  .app {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    font-size: 11px;
    line-height: 1.35;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 20px 12px;
  }
  .hello {
    color: var(--text-2);
  }
  .user {
    font-size: 14px;
    font-weight: 700;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--primary-fixed) 40%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
    color: var(--primary);
    font-size: 12px;
    font-weight: 700;
  }
  .body {
    display: grid;
    gap: 14px;
    flex: 1;
    align-content: start;
    min-height: 0;
    padding: 0 20px;
    overflow: hidden;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .balance {
    padding: 16px;
    border-radius: var(--r-md);
    background: linear-gradient(135deg, var(--primary), var(--primary-hover));
    color: #fff;
  }
  .balance :global(.icon) {
    color: var(--primary-fixed);
  }
  .overline {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f5fff7;
  }
  .amount {
    margin: 4px 0 8px;
    font-size: 24px;
    line-height: 32px;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .delta {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--primary-fixed);
    font-weight: 500;
  }
  .delta span {
    padding: 1px 6px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.2);
    color: #fff;
    font-weight: 600;
  }
  .pulse {
    padding: 12px;
    border-radius: var(--r-md);
    background: var(--surface-low);
    border: 1px solid #e2e2e4;
  }
  .title {
    font-weight: 600;
  }
  .fps,
  .link {
    color: var(--primary);
    font-size: 10px;
    font-weight: 500;
  }
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 48px;
    margin-top: 8px;
  }
  .bars span {
    flex: 1;
    height: var(--h);
    border-radius: 4px 4px 0 0;
    background: var(--primary);
    transform-origin: bottom;
  }
  .bars .muted {
    background: #e2e2e4;
  }
  .bars .p40 {
    background: color-mix(in srgb, var(--primary) 40%, transparent);
  }
  .bars .p60 {
    background: color-mix(in srgb, var(--primary) 60%, transparent);
  }
  .bars .p2 {
    background: var(--primary-hover);
  }
  .transfers {
    display: grid;
    gap: 8px;
  }
  .tx {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px;
    border-radius: var(--r);
    background: #f9f9fb;
    border: 1px solid var(--surface-container);
  }
  .tx-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tx-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--r);
    background: var(--primary-soft);
    color: var(--primary);
  }
  .tx-name {
    font-weight: 600;
    line-height: 1.1;
  }
  .tx-sub {
    font-size: 9px;
    color: var(--text-2);
  }
  .tx-amt {
    font-weight: 600;
  }
  .tx-amt.plus {
    color: var(--primary);
  }
  .dock {
    display: flex;
    justify-content: space-between;
    padding: 10px 24px;
    border-top: 1px solid var(--surface-container);
    color: var(--text-2);
  }
  .dock :global(.on) {
    color: var(--primary);
  }

  /* After the phone settles (parent gets .settled): content builds in.
     All transform/opacity, staggered by --u, bars grow by --b. */
  :global(.js) .ui {
    opacity: 0;
    transform: translateY(8px);
  }
  :global(.js) .bars span {
    transform: scaleY(0.12);
  }
  :global(.settled) .ui {
    opacity: 1;
    transform: none;
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
    transition-delay: calc(var(--u) * 90ms);
  }
  :global(.settled) .bars span {
    transform: none;
    transition: transform 600ms var(--ease-out);
    transition-delay: calc(180ms + var(--b) * 55ms);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .ui,
    :global(.js) .bars span {
      opacity: 1;
      transform: none;
    }
  }
</style>
