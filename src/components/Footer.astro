---
interface Props {
  name: string;
}
const { name } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p>© {year} {name}</p>
    <p>
      Built with Astro. Flutter demos run inside it ·
      <a href="https://github.com/phawadshah2/portfolio" target="_blank" rel="noopener noreferrer"
        >View source</a
      >
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 32px;
  }
  a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
