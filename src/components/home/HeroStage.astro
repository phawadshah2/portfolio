---
/**
 * Hero visual: one dominant phone with three UI panels layered behind it.
 *
 * Entrance (all transform/opacity):
 *   phone rises + scales in (900ms) -> panels follow, staggered -> once the
 *   phone settles, the UI inside it builds in (FinanceScreen `.ui`).
 * Pointer (desktop mice only): the group tilts up to 5deg towards the
 * cursor with interpolation; panels drift with smaller parallax by depth.
 * Resting: a barely-there 4px float on the phone.
 */
import Icon from '../Icon.astro';
import FinanceScreen from '../phone/FinanceScreen.astro';
import PhoneFrame from '../phone/PhoneFrame.astro';
---

<div class="stage" data-stage>
  <div class="glow" aria-hidden="true"></div>
  <div class="ring" aria-hidden="true"></div>

  <!-- Background panels: depth (--z) scales their parallax travel. -->
  <div class="panel p-store" style="--z: 0.6" aria-hidden="true">
    <div class="panel-in" data-reveal style="--d: 8; --rise: 24px; --dur: 650ms">
      <div class="store-img"><Icon name="store" size={22} /></div>
      <div class="store-row">
        <div>
          <p class="strong">Minimal Linen Shirt</p>
          <p class="sub">AED 189.00</p>
        </div>
        <span class="add">Add</span>
      </div>
      <p class="note"><Icon name="bolt" size={12} /> Instant Express Delivery in 45m</p>
    </div>
  </div>

  <div class="panel p-insight" style="--z: 0.85" aria-hidden="true">
    <div class="panel-in" data-reveal style="--d: 9; --rise: 24px; --dur: 650ms">
      <p class="insight-title"><Icon name="sparkle" size={13} /> Cadence AI Insight</p>
      <p class="sub">Focus peaks at 10 AM. Scheduling deep-work widgets now.</p>
      <p class="streak">Day 24 Streak 🔥</p>
    </div>
  </div>

  <div class="panel p-health" style="--z: 0.45" aria-hidden="true">
    <div class="panel-in" data-reveal style="--d: 10; --rise: 24px; --dur: 650ms">
      <div class="meter-row"><span>Lung Capacity</span><span class="ok">92% Restored</span></div>
      <div class="track"><span style="--v: 0.92"></span></div>
      <div class="meter-row"><span>Oxygen Levels</span><span class="ok">100%</span></div>
      <div class="track"><span style="--v: 1"></span></div>
    </div>
  </div>

  <!-- Foreground phone. -->
  <div class="fg" style="--z: 1">
    <div class="fg-in" data-reveal data-settle style="--d: 5; --rise: 48px; --dur: 950ms">
      <div class="float">
        <PhoneFrame label="Flutter app dashboard showing a portfolio balance, a performance chart and recent transfers">
          <FinanceScreen />
        </PhoneFrame>
      </div>
    </div>
  </div>
</div>

<script>
  // Pointer tilt with interpolation: the target follows the cursor, the
  // rendered value eases towards it each frame, and the loop stops itself
  // once it has caught up (no idle rAF).
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (stage && fine.matches && !reduced.matches) {
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    let frame = 0;

    const step = () => {
      current.x += (target.x - current.x) * 0.09;
      current.y += (target.y - current.y) * 0.09;
      stage.style.setProperty('--tx', current.x.toFixed(4));
      stage.style.setProperty('--ty', current.y.toFixed(4));
      const settled =
        Math.abs(target.x - current.x) < 0.001 && Math.abs(target.y - current.y) < 0.001;
      frame = settled ? 0 : requestAnimationFrame(step);
    };
    const kick = () => {
      if (!frame) frame = requestAnimationFrame(step);
    };

    // Track over the whole hero section so the motion starts before the
    // pointer reaches the phone itself.
    const area = stage.closest('section') ?? stage;
    area.addEventListener('pointermove', (event) => {
      const e = event as PointerEvent;
      if (e.pointerType !== 'mouse') return;
      const rect = stage.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      target.x = Math.max(-1, Math.min(1, (e.clientX - cx) / (rect.width * 0.9)));
      target.y = Math.max(-1, Math.min(1, (e.clientY - cy) / (rect.height * 0.9)));
      kick();
    });
    area.addEventListener('pointerleave', () => {
      target.x = 0;
      target.y = 0;
      kick();
    });
  }
</script>

<style>
  .stage {
    --tx: 0;
    --ty: 0;
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    padding-block: 24px;
    perspective: 1400px;
  }

  /* Subtle emerald light + a thin geometric ring behind the composition. */
  .glow {
    position: absolute;
    inset: 10% 5%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--primary-bright) 16%, transparent), transparent);
    filter: blur(8px);
  }
  .ring {
    position: absolute;
    width: 92%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--primary) 18%, transparent);
    transform: translate(calc(var(--tx) * -6px), calc(var(--ty) * -6px));
  }

  /* Tilt: whole layers move with the pointer; depth scales the travel. */
  .fg,
  .panel {
    transform:
      translate3d(calc(var(--tx) * var(--z) * 14px), calc(var(--ty) * var(--z) * 10px), 0)
      rotateY(calc(var(--tx) * var(--z) * 5deg))
      rotateX(calc(var(--ty) * var(--z) * -5deg));
  }
  .fg {
    position: relative;
    z-index: 3;
    --phone-w: clamp(260px, 72vw, 316px);
  }
  .fg-in {
    /* Phone entrance: rise + slight scale-up, shadow develops with it. */
    transform: none;
  }
  :global(.js) .fg-in:not(.is-visible) {
    transform: translateY(48px) scale(0.96);
  }
  .float {
    animation: float 7s ease-in-out infinite alternate;
    animation-delay: 1.2s;
  }
  @keyframes float {
    from {
      transform: translateY(-2px);
    }
    to {
      transform: translateY(2px);
    }
  }

  .panel {
    position: absolute;
    z-index: 2;
  }
  .panel-in {
    display: grid;
    gap: 8px;
    padding: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md), 0 0 0 1px rgb(15 23 42 / 0.02);
    font-size: 11px;
    line-height: 1.4;
  }
  .p-store {
    top: 8%;
    left: -16%;
    width: 156px;
    rotate: -6deg;
  }
  .p-insight {
    bottom: 12%;
    left: -20%;
    width: 184px;
    rotate: 3deg;
  }
  .p-health {
    top: 30%;
    right: -14%;
    width: 156px;
    rotate: 5deg;
  }
  .store-img {
    display: grid;
    place-items: center;
    height: 54px;
    border-radius: var(--r);
    background: var(--surface-container);
    color: #9ca3af;
  }
  .store-row,
  .meter-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .strong {
    font-weight: 600;
  }
  .sub {
    color: var(--text-2);
    font-size: 10px;
  }
  .add {
    padding: 3px 7px;
    border-radius: 4px;
    background: var(--primary);
    color: #fff;
    font-size: 9px;
    font-weight: 700;
  }
  .note,
  .insight-title {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--primary-ink);
    font-size: 10px;
    font-weight: 600;
  }
  .streak {
    justify-self: start;
    padding: 2px 8px;
    border-radius: 9999px;
    background: var(--primary-soft);
    color: var(--primary-ink);
    font-size: 10px;
    font-weight: 600;
  }
  .meter-row {
    font-size: 10px;
  }
  .ok {
    color: var(--primary);
    font-weight: 600;
  }
  .track {
    height: 5px;
    border-radius: 9999px;
    background: var(--surface-container);
    overflow: hidden;
  }
  .track span {
    display: block;
    height: 100%;
    background: var(--primary);
    transform: scaleX(var(--v));
    transform-origin: left;
    transition: transform 900ms var(--ease-out) 400ms;
  }
  :global(.js) .panel-in:not(.is-visible) .track span {
    transform: scaleX(0);
  }

  /* Smaller screens: keep the phone and one supporting layer. */
  @media (max-width: 767px) {
    .p-store,
    .p-insight {
      display: none;
    }
    .p-health {
      top: auto;
      bottom: 16%;
      right: 0;
      width: 140px;
    }
  }
  /* Narrow desktops: keep the outer panels inside the viewport. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .p-health {
      right: -3%;
      width: 140px;
    }
    .p-store {
      left: -10%;
      width: 140px;
    }
    .p-insight {
      left: -12%;
      width: 168px;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .stage {
      max-width: 480px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float {
      animation: none;
    }
    :global(.js) .fg-in:not(.is-visible) {
      transform: none;
    }
  }
</style>
