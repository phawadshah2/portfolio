---
import Icon from '../Icon.astro';

interface Entry {
  role: string;
  company: string;
  location?: string;
  period: string;
  current: boolean;
  highlights: string[];
}
interface Props {
  entries: Entry[];
}
const { entries } = Astro.props;
// Markers are spread across the line's draw time so each one appears as the
// line reaches it.
const DRAW_MS = 900;
const step = Math.round(DRAW_MS / Math.max(entries.length, 1));
---

<ol class="timeline" data-timeline style={`--n: ${entries.length}; --step: ${step}ms`}>
  <span class="line" aria-hidden="true"></span>
  {
    entries.map((e, i) => (
      <li class="item" style={`--i: ${i}`}>
        <span class:list={['dot', { current: e.current }]} data-tone={i} aria-hidden="true" />
        <div class="entry">
          <div class="head">
            <h3 class="role">{e.role}</h3>
            <p class:list={['period', { current: e.current }]}>{e.period}</p>
          </div>
          <p class="company">
            {e.company}
            {e.location && ` · ${e.location}`}
          </p>
          <ul class="highlights">
            {e.highlights.map((h) => (
              <li>
                <Icon name="check" size={16} />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 40px;
    padding-left: 40px;
  }
  .line {
    position: absolute;
    left: 9px;
    top: 10px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
    background: var(--border-strong);
    transform-origin: top;
  }
  .item {
    position: relative;
  }
  .dot {
    position: absolute;
    left: -40px;
    top: 4px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 4px solid var(--bg);
    background: #cbd5e1;
    box-shadow: 0 0 0 1px var(--border);
  }
  .dot[data-tone='1'] {
    background: #94a3b8;
  }
  .dot.current {
    background: var(--primary);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 15%, transparent);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }
  .role {
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .period {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .period.current {
    color: var(--primary);
  }
  .company {
    margin: 4px 0 12px;
    color: var(--text-2);
    font-size: 14px;
    font-weight: 500;
  }
  .highlights {
    display: grid;
    gap: 8px;
  }
  .highlights li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 10px;
    color: var(--text-2);
    font-size: 14px;
    line-height: 22px;
  }
  .highlights :global(.icon) {
    margin-top: 3px;
    color: var(--primary);
  }

  /* Progressive draw: line -> marker as the line reaches it -> entry. */
  :global(.js) .timeline:not(.is-drawn) .line {
    transform: scaleY(0);
  }
  :global(.js) .timeline:not(.is-drawn) .dot {
    transform: scale(0);
  }
  :global(.js) .timeline:not(.is-drawn) .entry {
    opacity: 0;
    transform: translateY(12px);
  }
  .is-drawn .line {
    transition: transform 900ms var(--ease-in-out);
  }
  .is-drawn .dot {
    transition: transform 360ms cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(var(--i) * var(--step) + 60ms);
  }
  .is-drawn .entry {
    transition:
      opacity 480ms var(--ease-out),
      transform 480ms var(--ease-out);
    transition-delay: calc(var(--i) * var(--step) + 180ms);
  }
</style>
