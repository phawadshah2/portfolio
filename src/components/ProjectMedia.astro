---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../lib/content';
import { url } from '../lib/paths';

interface Props {
  project: Project;
}

const { data } = Astro.props.project;
const poster = data.cover ?? data.screenshots[0]?.src;
const hasMedia = Boolean(data.demo || data.video || data.screenshots.length);
---

{
  hasMedia && (
    <section class="media" aria-label="Demo and screenshots">
      {data.demo && (
        <div class="demo" data-reveal>
          {/* Nothing heavy loads until the visitor asks: a Flutter web build
              is several MB, so the iframe is created on click. */}
          <div class="phone" data-demo data-src={url(data.demo.url)}>
            {poster && <Image src={poster} alt="" width={360} class="poster" />}
            <button type="button" class="run" data-demo-run>
              <span class="run-icon">
                <Icon name="play" size={22} />
              </span>
              <span>Run the live app</span>
              <span class="run-hint">Flutter web build · loads a few MB</span>
            </button>
          </div>
          <div class="demo-side">
            <h2 class="headline">Try it live</h2>
            <p class="muted">
              {data.demo.note ??
                'This is the real Flutter app compiled for the web, running inside the page. Data stays in your browser.'}
            </p>
            <a href={url(data.demo.url)} target="_blank" rel="noopener noreferrer" class="full">
              <Icon name="expand" /> Open full screen
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          </div>
        </div>
      )}

      {data.video && (
        <video
          class="video"
          controls
          preload="none"
          playsinline
          src={url(data.video.src)}
          poster={data.video.poster?.src}
          data-reveal
        />
      )}

      {data.screenshots.length > 0 && (
        <ul class="shots" aria-label="Screenshots">
          {data.screenshots.map((s, i) => (
            <li data-reveal style={`--d: ${i % 4}`}>
              <Image src={s.src} alt={s.alt} width={320} loading="lazy" />
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((phone) => {
    const button = phone.querySelector<HTMLButtonElement>('[data-demo-run]');
    button?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = phone.dataset.src ?? '';
      frame.title = 'Live app demo';
      frame.allow = 'clipboard-write; fullscreen';
      frame.className = 'frame';
      phone.classList.add('loading');
      frame.addEventListener('load', () => phone.classList.replace('loading', 'running'));
      phone.append(frame);
      button.remove();
      frame.focus();
    });
  });
</script>

<style>
  .media {
    display: grid;
    gap: 32px;
  }

  .demo {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  .phone {
    position: relative;
    width: min(100%, 360px);
    aspect-ratio: 9 / 19.5;
    margin-inline: auto;
    overflow: hidden;
    border: 10px solid var(--text);
    border-radius: 44px;
    background: var(--surface-raised);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.5);
  }
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
  }
  .run {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    border: 0;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    color: var(--text);
    font: 600 1rem var(--font-body);
    cursor: pointer;
    transition: background-color var(--t-hover) var(--ease-out);
  }
  .run:hover {
    background: color-mix(in srgb, var(--bg) 35%, transparent);
  }
  .run-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    transition: transform var(--t-hover) var(--ease-out);
  }
  .run:hover .run-icon {
    transform: scale(1.08);
  }
  .run-hint {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .phone :global(.frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--bg);
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }
  .phone.running :global(.frame) {
    opacity: 1;
  }
  .phone.loading::after {
    content: 'Starting the app…';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .demo-side {
    display: grid;
    gap: 12px;
  }
  .full {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-weight: 600;
  }

  .video {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface-raised);
  }

  .shots {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .shots li {
    flex: 0 0 min(70%, 240px);
    scroll-snap-align: start;
  }
  .shots :global(img) {
    width: 100%;
    height: auto;
    border-radius: 20px;
    border: 1px solid var(--border);
  }

  @media (min-width: 1080px) {
    .demo {
      grid-template-columns: auto 1fr;
      gap: 64px;
    }
  }
</style>
