---
import { Image } from 'astro:assets';
import { projectPath, type Project } from '../lib/content';
import { url } from '../lib/paths';
import Icon from './Icon.astro';
import PhoneFrame from './phone/PhoneFrame.astro';
import ProjectPreview from './phone/ProjectPreview.astro';

interface Props {
  project: Project;
  /** Position in the list, for the reveal stagger. */
  index?: number;
}

const { project, index = 0 } = Astro.props;
const { data } = project;
const href = url(projectPath(project));
const shot = data.screenshots[0];
const title = data.name;
---

<li class="slot" data-reveal style={`--d: ${index}; --stagger: 100ms; --rise: 20px; --dur: 540ms`}>
  <article class="card" data-tilt>
    <div class="body">
      {
        (data.badge || data.category) && (
          <div class="pills">
            {data.badge && <span class="pill pill-primary">{data.badge}</span>}
            {data.category && <span class="pill pill-neutral">{data.category}</span>}
          </div>
        )
      }
      <h3 class="t-headline-md title">
        <!-- The whole card is clickable through this stretched link. -->
        <a href={href} class="stretched">{title}</a>
      </h3>
      <p class="summary">{data.summary}</p>
      <ul class="chips" aria-label="Technologies">
        {data.tags.map((t, i) => <li class:list={['chip', { 'chip-primary': i === 0 }]}>{t}</li>)}
      </ul>
      <span class="more" aria-hidden="true">
        View case study <Icon name="arrow-right" />
      </span>
    </div>

    <div class="visual" aria-hidden={data.preview ? undefined : 'true'}>
      <div class="visual-in">
        {
          data.preview ? (
            <ProjectPreview kind={data.preview} label={`${data.name} app screen`} />
          ) : (
            shot && (
              <PhoneFrame variant="mini">
                <Image src={shot.src} alt="" widths={[260, 520]} sizes="260px" loading="lazy" class="shot" />
              </PhoneFrame>
            )
          )
        }
      </div>
    </div>
  </article>
</li>

<style>
  .slot {
    list-style: none;
  }

  .card {
    --tilt-x: 0;
    --tilt-y: 0;
    position: relative;
    display: grid;
    gap: 32px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    /* Return to rest is a touch slower than the hover response. */
    transform: perspective(1200px) rotateX(calc(var(--tilt-y) * -2.5deg))
      rotateY(calc(var(--tilt-x) * 2.5deg));
    transition:
      transform var(--t-return) var(--ease-out),
      border-color var(--t-return) var(--ease-out),
      box-shadow var(--t-return) var(--ease-out);
  }
  @media (hover: hover) {
    .card:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-md);
      transition-duration: var(--t-hover);
    }
  }
  @media (min-width: 1024px) {
    .card {
      grid-template-columns: 7fr 5fr;
      align-items: center;
      gap: 48px;
      padding: 40px;
    }
  }

  .body {
    display: grid;
    gap: 16px;
    justify-items: start;
    order: 2;
  }
  @media (min-width: 1024px) {
    .body {
      order: 1;
    }
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .title a {
    color: var(--text);
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .stretched:focus-visible {
    outline: none;
  }
  .card:has(.stretched:focus-visible) {
    outline: 2px solid var(--primary-bright);
    outline-offset: 3px;
  }
  .summary {
    max-width: 52ch;
    color: var(--text-2);
  }
  .chips {
    margin-block: 8px 4px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--primary);
    font-size: 14px;
    font-weight: 600;
  }
  .more :global(.icon) {
    transition: transform var(--t-hover) var(--ease-out);
  }
  @media (hover: hover) {
    .card:hover .more :global(.icon) {
      transform: translateX(4px);
    }
  }
  /* Phones: an explicit, full-width affordance instead of hover cues. */
  @media (hover: none) {
    .more {
      justify-content: center;
      width: 100%;
      padding: 10px 16px;
      border-radius: var(--r);
      background: var(--surface-low);
      border: 1px solid var(--border);
      color: var(--text);
    }
  }

  .visual {
    order: 1;
    display: grid;
    place-items: center;
    padding: 8px 0;
    --phone-w: min(260px, 100%);
  }
  @media (min-width: 1024px) {
    .visual {
      order: 2;
    }
  }
  .visual-in {
    transition: transform 400ms var(--ease-out);
  }
  @media (hover: hover) {
    .card:hover .visual-in {
      transform: scale(1.04);
      transition-duration: var(--t-hover);
    }
  }
  .shot {
    width: 100%;
    height: auto;
  }
</style>
