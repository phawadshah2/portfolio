---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import interUrl from '../assets/fonts/Inter-Regular.woff2?url';
import interBoldUrl from '../assets/fonts/Inter-Bold.woff2?url';
import { getHome, getProfile, hasDraftContent } from '../lib/content';
import { url } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  /** Site-relative path of the link-preview image. */
  image?: string;
}

const profile = await getProfile();
const home = await getHome();
const isDraft = await hasDraftContent();
const fullTitle = Astro.props.title
  ? `${Astro.props.title} · ${profile.name}`
  : `${profile.name} · ${profile.role}`;
const description =
  Astro.props.description ??
  `${profile.role} with 5+ years shipping cross-platform Android and iOS apps: clean architecture, testing, CI/CD and performance. ${profile.location}, ${profile.availability.toLowerCase()}.`;

// Absolute URLs need the deployed domain (SITE_URL); without it the tags
// fall back to relative paths, which most previewers still resolve.
const site = Astro.site;
// Clean URL: /portfolio/projects/x rather than .../x.html (build.format is 'file').
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonical = site ? new URL(cleanPath, site).href : undefined;
const imagePath = url(Astro.props.image ?? '/og-image.png');
const image = site ? new URL(imagePath, site).href : imagePath;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  sameAs: [profile.linkedin, profile.github],
  ...(site && { url: site.href }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121921" media="(prefers-color-scheme: dark)" />
    {isDraft && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/icons/icon-192.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    {site && <link rel="sitemap" href={url('/sitemap-index.xml')} />}

    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interBoldUrl} as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <!-- Runs before first paint: applies the saved theme (no flash) and
         enables reveal styles only when JavaScript is available. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        // Saved choice wins; otherwise the OS preference applies via CSS.
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') root.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      isDraft && (
        <div class="draft-banner" role="note">
          Draft preview · sample content from the design, not real data
        </div>
      )
    }
    <Nav name={profile.name} role={profile.role} cv={profile.cv} />
    <main id="main">
      <slot />
    </main>
    <Footer
      name={profile.name}
      email={home.contact.email}
      whatsapp={home.contact.whatsapp}
      linkedin={profile.linkedin}
      github={profile.github}
    />

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>

<style>
  .draft-banner {
    padding: 6px var(--gutter);
    background: var(--banner-bg);
    color: var(--banner-ink);
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    letter-spacing: 0.01em;
  }
</style>
