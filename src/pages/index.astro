---
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/home/ContactForm.astro';
import HeroStage from '../components/home/HeroStage.astro';
import Timeline from '../components/home/Timeline.astro';
import Base from '../layouts/Base.astro';
import { getExperience, getHome, getProfile, getProjects } from '../lib/content';

const home = await getHome();
const profile = await getProfile();
const experience = await getExperience();
const projects = (await getProjects()).filter((p) => p.data.featured);
const { hero, metrics, work, services, process, stack, testimonials, contact } = home;
const whatsappHref = contact.whatsapp ? `https://wa.me/${contact.whatsapp.replace(/\D/g, '')}` : undefined;
// Hero reveal order: headline lines, paragraph, then badge + CTAs together.
const afterHeadline = hero.headline.length;
---

<Base>
  <!-- Hero -->
  <section class="hero container">
    <div class="hero-grid">
      <div class="hero-text">
        <p class="badge pill pill-primary" data-reveal style={`--d: ${afterHeadline + 1}`}>
          <span class="ping" aria-hidden="true"></span>
          {hero.badge}
        </p>
        <h1 class="t-hero headline">
          {
            hero.headline.map((line, i) => (
              <span class="line" data-reveal style={`--d: ${i}; --rise: 20px; --dur: 620ms; --stagger: 95ms`}>
                {line}{' '}
              </span>
            ))
          }
        </h1>
        <p class="t-body-lg intro" data-reveal style={`--d: ${afterHeadline}`}>{hero.intro}</p>
        <div class="ctas" data-reveal style={`--d: ${afterHeadline + 1}`}>
          <Button href={hero.primaryCta.href} icon="arrow-right">{hero.primaryCta.label}</Button>
          <Button href={hero.secondaryCta.href} variant="outline">{hero.secondaryCta.label}</Button>
        </div>
        {
          hero.trust.length > 0 && (
            <ul class="trust" data-reveal style={`--d: ${afterHeadline + 2}`}>
              {hero.trust.map((t) => (
                <li>
                  <Icon name={t.icon} size={18} />
                  {t.label}
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <HeroStage />
    </div>
  </section>

  <!-- Metrics -->
  <section class="container metrics-wrap" aria-label="At a glance">
    <dl class="metrics surface-card" data-reveal style="--rise: 12px">
      {
        metrics.map((m) => (
          <div class="metric">
            <dt class="t-label-sm metric-label">{m.label}</dt>
            <dd class:list={['metric-value', { accent: m.accent }]} data-count={m.value}>
              {m.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Work -->
  <section class="section container" id="work" aria-labelledby="work-title">
    <div class="split-head">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{work.eyebrow}</span>
        <h2 class="t-headline-lg" id="work-title">{work.title}</h2>
      </div>
      <p class="split-intro" data-reveal style="--d: 1">{work.intro}</p>
    </div>
    <ol class="projects">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </ol>
  </section>

  <!-- Services -->
  <section class="section container" id="services" aria-labelledby="services-title">
    <div class="section-head narrow">
      <span class="eyebrow" data-reveal>{services.eyebrow}</span>
      <h2 class="t-headline-lg" id="services-title" data-reveal style="--d: 1">{services.title}</h2>
      <p class="t-body-lg" data-reveal style="--d: 2">{services.intro}</p>
    </div>
    <ul class="services">
      {
        services.items.map((s, i) => (
          <li class:list={['surface-card service', { wide: s.wide }]} data-reveal style={`--d: ${i % 3}`}>
            <span class="icon-tile">
              <Icon name={s.icon} size={22} />
            </span>
            <h3 class="t-headline-sm">{s.title}</h3>
            <p class="service-body">{s.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- How I work -->
  <section class="section container" aria-labelledby="process-title">
    <div class="section-head centered">
      <p class="pill pill-primary process-badge" data-reveal>
        <Icon name="bolt" size={14} />
        {process.badge}
      </p>
      <h2 class="t-headline-lg" id="process-title" data-reveal style="--d: 1">{process.title}</h2>
    </div>
    <ol class="steps">
      {
        process.steps.map((s, i) => (
          <li class="surface-card step" data-reveal style={`--d: ${i}`}>
            <div class="step-top">
              <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
              <Icon name={s.icon} size={20} class="step-icon" />
            </div>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Stack -->
  <section class="section container" aria-labelledby="stack-title">
    <div class="surface-card stack" data-reveal="mask">
      <div class="section-head">
        <span class="eyebrow" data-reveal>{stack.eyebrow}</span>
        <h2 class="t-headline-lg" id="stack-title" data-reveal style="--d: 1">{stack.title}</h2>
      </div>
      <ul class="stack-rows">
        {
          stack.groups.map((g, i) => (
            <li class="stack-row" data-reveal style={`--d: ${i + 1}`}>
              <span class:list={['stack-name', { primary: g.primary }]}>{g.name}</span>
              <ul class="chips">
                {g.chips.map((c, j) => (
                  <li class:list={['chip', { 'chip-primary': g.primary && j === 0 }]}>{c}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Experience -->
  <section class="section container" id="about" aria-labelledby="experience-title">
    <div class="section-head">
      <span class="eyebrow" data-reveal>{home.experience.eyebrow}</span>
      <h2 class="t-headline-lg" id="experience-title" data-reveal style="--d: 1">{home.experience.title}</h2>
    </div>
    <Timeline entries={experience} />
  </section>

  <!-- Testimonials -->
  {
    testimonials.items.length > 0 && (
      <section class="section container" aria-labelledby="quotes-title">
        <div class="section-head">
          <span class="eyebrow" data-reveal>{testimonials.eyebrow}</span>
          <h2 class="t-headline-lg" id="quotes-title" data-reveal style="--d: 1">
            {testimonials.title}
          </h2>
        </div>
        <ul class="quotes">
          {testimonials.items.map((t, i) => (
            <li class="surface-card quote" data-reveal style={`--d: ${i}`}>
              <Icon name="quote" size={28} class="quote-mark" />
              <blockquote>“{t.quote}”</blockquote>
              <div class="who">
                <p class="who-name">{t.name}</p>
                <p class="who-role">{t.role}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Contact -->
  <section class="section container" id="contact" aria-labelledby="contact-title">
    <div class="surface-card contact" data-reveal style="--rise: 20px">
      <div class="contact-info">
        <span class="eyebrow">{contact.eyebrow}</span>
        <h2 class="t-headline-lg" id="contact-title">{contact.title}</h2>
        <p class="contact-body">{contact.body}</p>
        <ul class="channels">
          <li>
            <span class="channel-icon"><Icon name="mail" size={20} /></span>
            <div>
              <p class="channel-label">Direct Email</p>
              <a class="channel-value" href={`mailto:${contact.email}`}>{contact.email}</a>
            </div>
          </li>
          {
            contact.whatsapp && (
              <li>
                <span class="channel-icon"><Icon name="chat" size={20} /></span>
                <div>
                  <p class="channel-label">WhatsApp / Telegram</p>
                  <a class="channel-value" href={whatsappHref} target="_blank" rel="noopener noreferrer">
                    {contact.whatsapp}
                  </a>
                </div>
              </li>
            )
          }
          {
            contact.response && (
              <li>
                <span class="channel-icon"><Icon name="clock" size={20} /></span>
                <div>
                  <p class="channel-label">Response Time</p>
                  <p class="channel-value accent">{contact.response}</p>
                </div>
              </li>
            )
          }
        </ul>
        <div class="socials">
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
            <Icon name="id-card" size={20} />
          </a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
            <Icon name="code" size={20} />
          </a>
        </div>
      </div>
      <ContactForm email={contact.email} projectTypes={contact.projectTypes} />
    </div>
  </section>
</Base>

<style>
  /* ----- Hero ----- */
  .hero {
    padding-block: 48px 64px;
  }
  @media (min-width: 1024px) {
    .hero {
      padding-block: 96px;
    }
  }
  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 7fr 5fr;
      gap: 32px;
    }
  }
  .hero-text {
    display: grid;
    justify-items: start;
  }
  .badge {
    margin-bottom: 24px;
    padding: 6px 14px;
  }
  .ping {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--primary);
  }
  .ping::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--primary);
    animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  .headline {
    margin-bottom: 24px;
  }
  .headline .line {
    display: block;
  }
  .intro {
    max-width: 42rem;
    margin-bottom: 32px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 40px;
  }
  @media (max-width: 639px) {
    .ctas {
      display: grid;
      width: 100%;
      gap: 12px;
    }
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    width: 100%;
    padding-top: 24px;
    border-top: 1px solid var(--divider);
    color: var(--text-2);
    font-size: 12px;
    font-weight: 600;
  }
  .trust li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .trust :global(.icon) {
    color: var(--primary);
  }

  /* ----- Metrics ----- */
  .metrics-wrap {
    margin-bottom: 32px;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 0;
    padding: 24px;
  }
  .metric {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 4px;
  }
  .metric-value {
    margin: 0;
    font-size: 28px;
    line-height: 36px;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .metric-value.accent {
    color: var(--primary);
  }
  .metric-label {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  @media (min-width: 1024px) {
    .metrics {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      padding: 32px;
    }
    .metric {
      padding-inline: 24px;
      border-left: 1px solid var(--divider);
    }
    .metric:first-child {
      padding-left: 0;
      border-left: 0;
    }
    .metric-value {
      font-size: 36px;
      line-height: 44px;
    }
  }

  /* ----- Shared section heads ----- */
  .split-head {
    display: grid;
    gap: 16px;
    margin-bottom: 48px;
  }
  .split-head .section-head {
    margin-bottom: 0;
  }
  .split-intro {
    max-width: 30rem;
    color: var(--text-2);
  }
  @media (min-width: 768px) {
    .split-head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  .narrow {
    max-width: 48rem;
  }
  .centered {
    justify-items: center;
    text-align: center;
  }

  /* ----- Work ----- */
  .projects {
    display: grid;
    gap: 32px;
  }

  /* ----- Services ----- */
  .services {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .services {
      grid-template-columns: repeat(3, 1fr);
    }
    .service.wide {
      grid-column: span 2;
    }
  }
  .service {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: 28px;
    transition:
      border-color var(--t-return) var(--ease-out),
      box-shadow var(--t-return) var(--ease-out),
      translate var(--t-return) var(--ease-out);
  }
  @media (hover: hover) {
    .service:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-md);
      translate: 0 -2px;
      transition-duration: var(--t-hover);
    }
  }
  .service .icon-tile {
    margin-bottom: 8px;
  }
  .service-body {
    color: var(--text-2);
    font-size: 14px;
    line-height: 23px;
  }

  /* ----- Process ----- */
  .process-badge {
    margin-bottom: 8px;
  }
  .steps {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .step {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 20px;
  }
  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .step-num {
    color: var(--primary);
    font-size: 20px;
    font-weight: 700;
  }
  .step :global(.step-icon) {
    color: var(--placeholder);
    transition: color var(--t-hover) var(--ease-out);
  }
  .step:hover :global(.step-icon) {
    color: var(--primary);
  }
  .step-title {
    font-size: 15px;
    font-weight: 600;
  }
  .step-body {
    color: var(--text-2);
    font-size: 14px;
    line-height: 20px;
  }

  /* ----- Stack ----- */
  .stack {
    padding: 28px;
  }
  @media (min-width: 1024px) {
    .stack {
      padding: 48px;
    }
  }
  .stack-rows {
    display: grid;
    gap: 16px;
  }
  .stack-row {
    display: grid;
    gap: 12px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface-alt);
  }
  @media (min-width: 768px) {
    .stack-row {
      grid-template-columns: 180px 1fr;
      align-items: center;
    }
  }
  .stack-name {
    justify-self: start;
    font-size: 15px;
    font-weight: 600;
  }
  .stack-name.primary {
    padding: 3px 10px;
    border-radius: var(--r-sm);
    background: var(--primary);
    color: var(--on-primary);
    font-size: 13px;
  }

  /* ----- Testimonials ----- */
  .quotes {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .quotes {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .quote {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: 32px;
  }
  .quote :global(.quote-mark) {
    color: var(--primary);
  }
  blockquote {
    margin: 0;
    font-size: 18px;
    line-height: 29px;
    font-style: italic;
  }
  .who {
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .who-name {
    font-size: 14px;
    font-weight: 600;
  }
  .who-role {
    color: var(--text-2);
    font-size: 12px;
    font-weight: 500;
  }

  /* ----- Contact ----- */
  .contact {
    display: grid;
    gap: 40px;
    padding: 28px;
  }
  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: 1fr 1.1fr;
      gap: 56px;
      padding: 56px;
    }
  }
  .contact-info {
    display: grid;
    align-content: start;
    gap: 16px;
  }
  .contact-body {
    color: var(--text-2);
  }
  .channels {
    display: grid;
    gap: 16px;
    margin-top: 16px;
  }
  .channels li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .channel-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r);
    background: var(--surface-container);
    color: var(--primary);
  }
  .channel-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-2);
  }
  .channel-value {
    font-size: 14px;
    font-weight: 600;
  }
  a.channel-value:hover {
    color: var(--primary);
  }
  .channel-value.accent {
    color: var(--primary);
  }
  .socials {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 46px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r);
    transition:
      border-color var(--t-hover) var(--ease-out),
      color var(--t-hover) var(--ease-out),
      transform var(--t-press) var(--ease-out);
  }
  .socials a:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .socials a:active {
    transform: scale(0.95);
  }
</style>
