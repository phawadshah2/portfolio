---
import ProjectCard from '../../components/ProjectCard.astro';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Base title="Projects" description="Apps and case studies by Fawad Shah.">
  <section class="section container">
    <div class="section-head">
      <span class="eyebrow" data-reveal>Projects</span>
      <h1 class="t-headline-lg" data-reveal style="--d: 1">All work</h1>
      <p class="t-body-lg intro" data-reveal style="--d: 2">
        Mobile platforms and case studies, with live demos where they run on the web.
      </p>
    </div>
    <ol class="list">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </ol>
  </section>
</Base>

<style>
  .intro {
    max-width: 40rem;
  }
  .list {
    display: grid;
    gap: 32px;
  }
</style>
